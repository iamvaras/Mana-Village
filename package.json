{
  "name": "mana-village",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/core/src/types/database.ts"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "supabase": "3.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
