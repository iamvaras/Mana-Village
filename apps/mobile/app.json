{
  "expo": {
    "name": "Mana Village",
    "slug": "mana-village",
    "scheme": "manavillage",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.manavillage.app"
    },
    "android": {
      "package": "in.manavillage.app",
      "adaptiveIcon": {
        "backgroundColor": "#EEF7F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Mana Village uses the camera to take photos of village problems you report.",
          "photosPermission": "Mana Village lets you choose photos of village problems you report.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mana Village uses your location only when you report a problem, so the Panchayat can find it."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F7A4A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "iamvaras",
    "extra": {
      "eas": {
        "projectId": "b5919f49-83ae-4eed-8f21-a471c7148c91"
      }
    }
  }
}
